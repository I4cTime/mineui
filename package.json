{
  "name": "mineui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:electron": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "electron-builder",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@heroui/react": "^3.0.0-beta.2",
    "@heroui/styles": "^3.0.0-beta.2",
    "howler": "^2.2.4",
    "lucide-react": "^0.555.0",
    "minecraft-server-util": "^5.4.1",
    "motion": "^12.23.24",
    "next": "16.1.1",
    "rcon-client": "^4.2.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/howler": "^2.2.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^34.5.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mineui.desktop",
    "productName": "MineUI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
